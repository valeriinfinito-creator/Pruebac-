@model DeportivoApp.ViewModels.EspacioCreateViewModel

@{
    ViewData["Title"] = "Editar Espacio";
}

<h2>✏️ Editar Espacio</h2>

<form asp-action="Edit" method="post" class="card card-wow p-4">

    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="Nombre"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Tipo"></label>
        <input asp-for="Tipo" class="form-control" />
        <span asp-validation-for="Tipo" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Capacidad"></label>
        <input asp-for="Capacidad" type="number" min="1" class="form-control" />
        <span asp-validation-for="Capacidad" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>Estado</label>
        <select asp-for="Estado" class="form-select">
            <option>Disponible</option>
            <option>Mantenimiento</option>
        </select>
    </div>

    <button type="submit" class="btn btn-wow">
        💾 Actualizar
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancelar
    </a>

</form>
