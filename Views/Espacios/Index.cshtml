@model List<DeportivoApp.Models.Espacio>

@{
    ViewData["Title"] = "Espacios";
}

<h2 class="mb-3">📅 Gestión de Espacios</h2>

<a class="btn btn-wow mb-3" asp-action="Create">
    ➕ Nuevo Espacio
</a>

<form method="get" class="mb-3 d-flex gap-2">
    <select name="tipo" class="form-select" style="max-width: 280px;">
        <option value="">-- Todos los tipos --</option>
        @foreach (var t in (IEnumerable<string>)(ViewBag.Tipos ?? new List<string>()))
        {
            if (string.Equals((string?)ViewBag.TipoSeleccionado, t, StringComparison.OrdinalIgnoreCase))
            {
                        <option value="@t" selected>@t</option>
            }
            else
            {
                        <option value="@t">@t</option>
            }
        }
    </select>
    <button class="btn btn-primary" type="submit">Filtrar</button>
    <a class="btn btn-secondary" asp-action="Index">Limpiar</a>
</form>

<table class="table table-hover shadow-sm bg-white rounded">

    <thead class="table-success">
    <tr>
        <th>Nombre</th>
        <th>Tipo</th>
        <th>Capacidad</th>
        <th>Estado</th>
        <th>Acciones</th>
    </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>

                <td>@item.Nombre</td>
                <td>@item.Tipo</td>
                <td>@item.Capacidad</td>

                <td>
                    <span class="badge bg-info">@item.Estado</span>
                </td>

                <td>

                    <a class="btn btn-sm btn-primary"
                       asp-action="Edit"
                       asp-route-id="@item.Id">
                        Editar
                    </a>

                    <a class="btn btn-sm btn-danger"
                       asp-action="Delete"
                       asp-route-id="@item.Id">
                        Eliminar
                    </a>

                </td>

            </tr>
        }
    </tbody>

</table>
