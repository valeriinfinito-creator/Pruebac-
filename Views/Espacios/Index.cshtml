@model List<DeportivoApp.Models.Espacio>

@{
    ViewData["Title"] = "Espacios";
}

<h2 class="mb-3">📅 Gestión de Espacios</h2>

<a class="btn btn-wow mb-3" asp-action="Create">
    ➕ Nuevo Espacio
</a>

<table class="table table-hover shadow-sm bg-white rounded">

    <thead class="table-success">
    <tr>
        <th>Usuario</th>
        <th>Fecha</th>
        <th>Hora</th>
        <th>Estado</th>
        <th>Acciones</th>
    </tr>
    </thead>

    <tbody>
    @foreach (var item in Model)
    {
        <tr>

            <td>@item.Usuario?.Nombre</td>
            <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
            <td>@item.HoraInicio.ToString("HH:mm") - @item.HoraFin.ToString("HH:mm")</td>

            <td>
                <span class="badge bg-info">@item.Estado</span>
            </td>

            <td>

                <a class="btn btn-sm btn-primary"
                   asp-action="Edit"
                   asp-route-id="@item.Id">
                    Editar
                </a>

                <a class="btn btn-sm btn-danger"
                   asp-action="Delete"
                   asp-route-id="@item.Id">
                    Eliminar
                </a>

            </td>

        </tr>
    }
    </tbody>

</table>