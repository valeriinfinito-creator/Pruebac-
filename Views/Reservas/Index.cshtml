@model List<DeportivoApp.Models.Reserva>

@{
    ViewData["Title"] = "Reservas";
}

<h2 class="mb-3">📅 Gestión de Reservas</h2>

<a class="btn btn-wow mb-3" asp-action="Create">
    ➕ Nueva Reserva
</a>

<form method="get" class="mb-3 d-flex gap-2 flex-wrap">
    <select name="usuarioId" class="form-select" style="max-width: 280px;">
        <option value="">-- Todos los usuarios --</option>
        @foreach (var u in (IEnumerable<SelectListItem>)(ViewBag.Usuarios ?? new List<SelectListItem>()))
        {
            <option value="@u.Value" selected="@u.Selected">@u.Text</option>
        }
    </select>
    <select name="espacioId" class="form-select" style="max-width: 280px;">
        <option value="">-- Todos los espacios --</option>
        @foreach (var e in (IEnumerable<SelectListItem>)(ViewBag.Espacios ?? new List<SelectListItem>()))
        {
            <option value="@e.Value" selected="@e.Selected">@e.Text</option>
        }
    </select>
    <button class="btn btn-primary" type="submit">Filtrar</button>
    <a class="btn btn-secondary" asp-action="Index">Limpiar</a>
</form>

<table class="table table-hover shadow-sm bg-white rounded">

    <thead class="table-success">
    <tr>
        <th>Usuario</th>
        <th>Espacio</th>
        <th>Fecha</th>
        <th>Hora</th>
        <th>Estado</th>
        <th>Acciones</th>
    </tr>
    </thead>

    <tbody>
    @foreach (var item in Model)
    {
        <tr>

            <td>@item.Usuario?.Nombre</td>
            <td>@item.Espacio?.Nombre</td>
            <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
            <td>@item.HoraInicio.ToString(@"hh\:mm") - @item.HoraFin.ToString(@"hh\:mm")</td>

            <td>
                <span class="badge bg-info">@item.Estado</span>
            </td>

            <td>

                <a class="btn btn-sm btn-primary"
                   asp-action="Edit"
                   asp-route-id="@item.Id">
                    Editar
                </a>

                <a class="btn btn-sm btn-danger"
                   asp-action="Delete"
                   asp-route-id="@item.Id">
                    Eliminar
                </a>

                @if (item.Estado == "Programada")
                {
                    <form asp-action="Cancelar" asp-route-id="@item.Id" method="post" style="display:inline;">
                        <button type="submit" class="btn btn-sm btn-warning">Cancelar</button>
                    </form>
                    <form asp-action="Finalizar" asp-route-id="@item.Id" method="post" style="display:inline;">
                        <button type="submit" class="btn btn-sm btn-success">Finalizar</button>
                    </form>
                }

            </td>

        </tr>
    }
    </tbody>

</table>
